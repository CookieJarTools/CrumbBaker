/* Root layout */
.crumbbaker-root {
    padding: 8px;
    background-color: #202124;
    flex-direction: column;
    row-gap: 6px;
}

/* Header */
.crumbbaker-header {
    unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 4px;
}

/* Generic card section */
.crumbbaker-section {
    border-radius: 4px;
    border-width: 1px;
    border-color: #333333;
    padding: 6px 8px;
    background-color: #181a1f;
    flex-direction: column;
    margin-bottom: 6px;
}

/* Slight variants for specific sections if you want to tweak later */
.crumbbaker-section-config {
}

.crumbbaker-section-rules {
}

/* Section titles */
.crumbbaker-section-title {
    unity-font-style: bold;
    font-size: 12px;
    margin-bottom: 2px;
}

.crumbbaker-section-subtitle {
    unity-font-style: bold;
    font-size: 11px;
    margin-bottom: 2px;
}

/* Horizontal rows */
.crumbbaker-row-horizontal {
    flex-direction: row;
    align-items: center;
    column-gap: 4px;
}

/* Vertical rows */
.crumbbaker-row-vertical {
    flex-direction: column;
    column-gap: 4px;
}

/* Text / enum fields */
.crumbbaker-text-field {
    flex-grow: 1;
}

.crumbbaker-enum-field {
    min-width: 90px;
}

/* Manual rules scroll area */
.crumbbaker-rules-scroll {
    max-height: 260px;
    margin-top: 4px;
}

/* Rule card */
.crumbbaker-rule-card {
    border-radius: 3px;
    border-width: 1px;
    border-color: #333333;
    border-style: solid;
    padding: 4px;
    margin-bottom: 4px;
    background-color: #202329;
    row-gap: 2px;
}

/* Results summary + list */
.crumbbaker-summary-label {
    margin-bottom: 2px;
}

.crumbbaker-summary-ok {
    color: #7bd88f;
}

.crumbbaker-issues-scroll {
    max-height: 200px;
}

/* Individual issue rows */
.crumbbaker-issue {
    padding: 2px 4px;
    margin-bottom: 2px;
    border-radius: 2px;
    border-width: 1px;
    border-style: solid;
    font-size: 11px;
}

.crumbbaker-issue-error {
    border-color: #b63232;
    background-color: #3b2020;
}

.crumbbaker-issue-warning {
    border-color: #a67c1f;
    background-color: #3a3018;
}

/* Bottom bar */
.crumbbaker-bottom-bar {
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: #333333;
    flex-direction: row;
    align-items: center;
}

/* Buttons */
.crumbbaker-button-primary {
    min-height: 24px;
    padding-left: 12px;
    padding-right: 12px;
    unity-font-style: bold;
    background-color: #1e5f2d;
}

.crumbbaker-button-primary:hover {
    background-color: #247538;
}

.crumbbaker-button-secondary {
    min-height: 22px;
}

.crumbbaker-button-secondary:hover {
    background-color: #2b2f36;
}

.crumbbaker-button-danger {
    min-width: 22px;
    min-height: 22px;
    background-color: #7a3030;
}

.crumbbaker-button-danger:hover {
    background-color: #9a3b3b;
}
